#!/usr/bin/env bash
# Store a secret in the local Secret Service (gnome-keyring, viewable in Seahorse).
# Usage: secret-set <application> <KEY>            interactive, hidden prompt
#        printf '%s' "value" | secret-set <application> <KEY> --stdin
# Inspect:  secret-tool lookup application <app> key <KEY>
# Delete:   secret-tool clear application <app> key <KEY>
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: secret-set <application> <KEY> [--stdin]" >&2
  exit 2
fi

app=$1
keyname=$2
mode=${3:-}

if [[ "$mode" == "--stdin" ]]; then
  value=$(cat)
else
  printf 'value for %s / %s: ' "$app" "$keyname" >&2
  IFS= read -rs value
  echo >&2
fi

if [[ -z "$value" ]]; then
  echo "error: empty value, nothing stored" >&2
  exit 1
fi

printf '%s' "$value" | secret-tool store --label="$app:$keyname" application "$app" key "$keyname"
echo "stored: application=$app key=$keyname (collection: Login, see Seahorse)"
