{{- if eq (default "workstation" .dotfiles_profile) "server" }}
# Managed by Chezmoi: server profile
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS="-FRX"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt append_history share_history hist_ignore_dups hist_reduce_blanks

autoload -Uz compinit
compinit

if [[ -r "$HOME/.config/zsh/fzf.zsh" ]]; then
  source "$HOME/.config/zsh/fzf.zsh"
fi

# Persist the Neovim color preference without bringing in workstation theming.
# New Neovim sessions read this marker; use :Light or :Dark in a running one.
light() {
  command touch "$HOME/.lightmode"
  print 'Light mode enabled for new Neovim sessions.'
}

dark() {
  command rm -f "$HOME/.lightmode"
  print 'Dark mode enabled for new Neovim sessions.'
}

# The server profile is self-contained; these helpers need no plugin manager.
check_sudo_nopass() {
  sudo -n true 2>/dev/null
}
if [[ -r "$HOME/.config/zsh/systemd-tools.zsh" ]]; then
  source "$HOME/.config/zsh/systemd-tools.zsh"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

alias v='nvim'
alias vi='nvim'
alias vim='nvim'
alias ll='ls -lah'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias gs='git status -sb'
alias gl='git log --oneline --decorate -20'
alias gd='git diff'

if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b)"
  alias ls='ls --color=auto'
fi
{{- else }}
# Initialize starship prompt
eval "$(starship init zsh)"

# Zinit is installed by chezmoi's pinned bootstrap script, never at shell startup.
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
	source "$ZINIT_HOME/zinit.zsh"
else
	print -u2 -- "Zinit is not installed; run 'chezmoi apply' to install the pinned revision."
fi

# ZSH vi mode
export ZVM_INIT_MODE=sourcing # vi mode for zsh

# # Core configuration files (order matters)
if (( ${+functions[zinit]} || ${+functions[zi]} )); then
	source "$HOME/.config/zsh/config.d/core/plugins.zsh" # Zinit plugins
fi
source "$HOME/.config/zsh/config.d/core/options.zsh"     # ZSH options
source "$HOME/.config/zsh/config.d/core/environment.zsh" # Environment variables
source "$HOME/.config/zsh/config.d/core/keybindings.zsh" # Key bindings
source "$HOME/.config/zsh/config.d/core/completion.zsh"  # Completion system
source "$HOME/.config/zsh/config.d/core/aliases.zsh"     # Aliases
#

# # Load remaining config files
if [ -d "$HOME/.config/zsh/config.d/other/" ]; then
	for conf in "$HOME/.config/zsh/config.d/other/"*.zsh; do
		source "${conf}"
	done
	unset conf
fi

# Atuin is installed by the pinned bootstrap; do not let startup fetch it.
ATUIN_ZINIT_DIR="${ZINIT_HOME:h}/plugins/atuinsh---atuin"
if [[ -x "$ATUIN_ZINIT_DIR/atuin" ]]; then
	typeset -U path
	path=("$ATUIN_ZINIT_DIR" $path)
	export PATH
	source "$HOME/.config/zsh/config.d/core/atuin_init.zsh"
else
	print -u2 -- "Atuin is not bootstrapped; run 'chezmoi apply'."
fi

# direnv
if command -v direnv > /dev/null 2>&1; then
	eval "$(direnv hook zsh)"
fi

if command -v zoxide > /dev/null 2>&1; then
	eval "$(zoxide init zsh --cmd j)"
fi


# Added by Antigravity CLI installer
export PATH="/home/kevinzehnder/.local/bin:$PATH"
{{- end }}
