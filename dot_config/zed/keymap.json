// Zed keymap (JSONC)
// Docs: https://zed.dev/docs/key-bindings
[
  // 1) Workspace wide (applies even outside an editor depending on context)
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-m": "terminal_panel::Toggle",
      "ctrl-alt-k": "pane::ActivatePreviousItem",
      "ctrl-alt-j": "pane::ActivateNextItem",
      "ctrl-p": "file_finder::Toggle",
      "ctrl-f": "pane::DeploySearch",
    },
  },

  // 2) Vim insert mode
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
    },
  },

  // 3) Vim normal mode (main leader bindings)
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // leader core
      "space w": "workspace::Save",
      "space c": "pane::CloseActiveItem",
      // "space x": "zed::Quit",

      // panels
      "space o": "outline_panel::ToggleFocus",
      "space d": "diagnostics::Deploy",
      "space g g": [
        "task::Spawn",
        { "task_name": "LazyGit", "reveal_target": "center" },
      ],

      // search
      "space /": "pane::DeploySearch",

      // buffer/item switch
      // pane focus
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",

      "shift-u": "vim::Redo",
      "ctrl-a": "editor::ToggleCodeActions",
      "alt-j": "editor::GoToDiagnostic",
      "alt-k": "editor::GoToPreviousDiagnostic",
      "alt-m": "diagnostics::Deploy",

      // "shift-y": ["workspace::SendKeystrokes", "y $"]
    },
  },

  // 4) No editor present
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      // "space f": "file_finder::Toggle"
    },
  },

  // 5) Vim control surface
  {
    "context": "VimControl",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },
  {
    "context": "FileFinder || (FileFinder > Picker > Editor) || (FileFinder > Picker > menu)",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-k": "editor::ContextMenuPrevious",
      "up": "editor::ContextMenuPrevious",
      "ctrl-j": "editor::ContextMenuNext",
      "down": "editor::ContextMenuNext",
      "pageup": "editor::ContextMenuFirst",
      "pagedown": "editor::ContextMenuLast",
    },
  },

  // 6) Terminal: keep shell shortcuts intact
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-j": ["terminal::SendKeystroke", "ctrl-j"],
      "ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
      "ctrl-l": ["terminal::SendKeystroke", "ctrl-l"],
    },
  },
  {
    "context": "SettingsWindow",
    "unbind": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "RulesLibrary",
    "unbind": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-w": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false,
        },
      ],
    },
  },
]
