layout {

    focus-ring {
        active-color   "#7aa2f7"
        inactive-color "#3b4261"
        urgent-color   "#f7768e"
    }

    border {
        active-color   "#7aa2f7"
        inactive-color "#3b4261"
        urgent-color   "#f7768e"
    }

    shadow {
        color "#16161e70"
    }

    tab-indicator {
        active-color   "#bb9af7"
        inactive-color "#9aa5ce"
        urgent-color   "#f7768e"
    }

    insert-hint {
        color "#7aa2f780"
    }
}

recent-windows {
    highlight {
        active-color "#7aa2f7"
        urgent-color "#f7768e"
    }
}
