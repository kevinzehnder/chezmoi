
% kz, zsh, system, services, monitoring, admin, pacman, yay, aur, packages
# Find And Edit Files With FZF+bat Preview
fe

# Search File Contents and Edit Matches (Ripgrep+Fzf)
fs

# journalctl -f thru tailspin (sudo/system)
jf

# journalctl thru tailspin (no sudo by default; supports --user)
jctl

# journalctl via sudo helper
sjctl

# Browse and Manage systemd units (system mode, no sudo)
# default view: service/socket/timer/target/path
units

# Browse and Manage user units (niri/noctalia)
units --user

# Show all systemd unit types (includes mount/device/swap/etc.)
units --all-types

# Browse enabled unit files
units -e

# Browse active runtime units
units -a

# Filter by explicit unit type(s)
units --type service
units --type timer
units --type mount

# Browse and manage system units with sudo
sunits

# Show options/help
units --help

# Browse and Manage Systemd Timers
timers

# View and Edit System Cron Jobs
crons

# Show System Info Summary
info

# Open TLDR Pages Using FZF
tldrf

# Build tcpdump filter thru FZF
netsniff

# Pacman: Search and Install Packages (FZF)
pkinstall <query>

# Pacman: List Installed Packages and Remove (FZF)
pklist

# Yay: List AUR Packages and Remove (FZF)
yaylist

# Yay: Search AUR+Repos and Install Packages (FZF)
yayinstall <query>
